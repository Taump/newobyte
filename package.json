{
  "name": "obyte-org",
  "version": "1.0.0",
  "description": "obyte.org — Payload CMS + Next.js",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build && node scripts/postbuild.mjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "start:prod": "sh scripts/start-standalone.sh",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "baseline": "tsx scripts/capture-baseline.ts",
    "migrate:grav": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env scripts/migrate-grav/index.ts",
    "baseline:query": "tsx scripts/baseline-query.ts",
    "visual:diff": "tsx scripts/visual-diff.ts",
    "compare:animation": "tsx scripts/compare-animation.ts",
    "extract:legacy-css": "tsx scripts/extract-legacy-css.ts && prettier --write src/shared/styles/legacy.css src/shared/styles/legacyBackgrounds.ts",
    "db:init": "sh scripts/db-init.sh",
    "db:export": "tsx scripts/db-export.ts",
    "check:links": "tsx scripts/check-links.ts",
    "perf": "lhci autorun --config=lighthouserc.cjs",
    "media:sizes": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env scripts/media-sizes.ts"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.94.0",
    "@payloadcms/next": "3.94.0",
    "@payloadcms/plugin-nested-docs": "3.94.0",
    "@payloadcms/plugin-seo": "3.94.0",
    "@payloadcms/richtext-lexical": "3.94.0",
    "@payloadcms/ui": "3.94.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.15.0",
    "isomorphic-dompurify": "^4.7.0",
    "next": "16.4.6",
    "payload": "3.94.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@lhci/cli": "~0.15.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "16.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "22.19.9",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.6",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.4",
    "gray-matter": "^4.0.3",
    "jsdom": "28.0.0",
    "marked": "^18.2.1",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.33",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
