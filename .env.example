# SQLite database file. Development: ./.db in the project. Production: a prepared database
# (pnpm db:export), e.g. file:/srv/obyte/data/payload.db; in Docker it is set by the image.
DATABASE_URL=file:./.db

# Long random string, e.g. `openssl rand -hex 32`. The app refuses to start without it.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public origin of the site: canonical URLs, Open Graph, sitemap, CORS/CSRF. Inlined at build
# time — set it before `pnpm build` (Docker: --build-arg). Leave empty in development.
NEXT_PUBLIC_SERVER_URL=

# The only admin-panel account (nobody can register or create users). Synced on every start:
# created or its password reset, every other account removed. Required in production;
# in development without them existing accounts are kept. Password: at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Hidden admin panel URL, e.g. /k3x9-panel-7q2m (letters, digits, - _). /admin then answers 404.
# Default: /admin. Keep it private — it is not listed anywhere on the site.
# ADMIN_PATH=

# Production without Docker only: absolute uploads directory (default: ./media)
# MEDIA_DIR=/srv/obyte/media
